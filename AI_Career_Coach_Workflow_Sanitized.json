    {
      "parameters": {
        "sendTo": "={{ $('Edit Fields').item.json.email }}",
        "subject": "Your Personalized AI Career Report",
        "message": "=\n={{\n`<!DOCTYPE html>\n<html>\n<body style=\"margin:0;padding:25px;background:#f4f6f9;font-family:Arial,sans-serif;\">\n  <div style=\"max-width:650px;margin:auto;background:#ffffff;border-radius:12px;overflow:hidden;\">\n    <div style=\"background:#173b65;padding:25px;text-align:center;color:white;\">\n      <h1 style=\"margin:0;font-size:24px;\">AI Career Coach</h1>\n      <p style=\"margin:8px 0 0;\">Your Personalized Career Report</p>\n    </div>\n\n    <div style=\"padding:28px;color:#333333;\">\n      <h2 style=\"color:#173b65;\">Hello ${$('Edit Fields').item.json.student_name || 'Student'},</h2>\n      <p>Your personalized AI career coaching report is ready!</p>\n\n      <div style=\"background:#f4f7fb;padding:20px;border-radius:8px;white-space:pre-wrap;line-height:1.6;\">${$('Basic LLM Chain').item.json.text || 'Your report is being prepared.'}</div>\n\n      <p style=\"margin-top:25px;\">Keep learning, practising, and moving towards your career goals!</p>\n      <p>Best wishes,<br><strong>AI Career Coach Assistant</strong></p>\n    </div>\n\n    <div style=\"background:#eef2f7;padding:15px;text-align:center;color:#667085;font-size:12px;\">\n      This report was generated using an AI-powered career coaching workflow.\n    </div>\n  </div>\n</body>\n</html>`\n}}\n",
